{
  "name": "urpet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A source-linked matcher for ten reviewed pet lanes, with the original 205-breed dog module preserved.",
  "scripts": {
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:credits": "node scripts/build-photo-credits.mjs",
    "build:static": "npm run build:catalog && npm run build:credits",
    "check:generated": "node scripts/build-catalog.mjs --check && node scripts/build-photo-credits.mjs --check",
    "check:guide-pricing": "node scripts/verify-cerebras-pricing.mjs",
    "dev": "wrangler dev",
    "community:reconcile": "node scripts/reconcile-community.mjs",
    "test": "node --test",
    "verify": "node scripts/verify.mjs && node scripts/verify-photos.mjs",
    "check": "npm run test && npm run check:generated && npm run verify && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
